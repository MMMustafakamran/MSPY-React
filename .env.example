# Copy to backend/.env (or a repo-root .env) and fill in.
# Never commit the filled-in file.

# ── Required: one model provider ────────────────────────────────────────────

# OpenAI
OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL_ID=gpt-5.4-mini

# ...or Azure OpenAI. When AZURE_OPENAI_ENDPOINT is set it takes precedence.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o-mini
# AZURE_OPENAI_API_KEY=...


# ── Backend, optional ───────────────────────────────────────────────────────

# Port for the FastAPI AG-UI server. Change this and MS_AGENT_URL together.
AGENT_PORT=8020

# Origins allowed to call the agent directly.
AGENT_CORS_ORIGINS=http://localhost:3020,http://127.0.0.1:3020

# Enables the bearer-token middleware from the Authentication page. Leave unset
# to run unauthenticated; set it and every AG-UI endpoint demands a matching
# Authorization header. See the /auth route.
# AUTH_BEARER_TOKEN=super-secret-demo-token


# ── Frontend, optional ──────────────────────────────────────────────────────
# These belong in frontend/.env.local (Next.js does not read this file).

# Where the runtime reaches the AG-UI server. Use 127.0.0.1 if localhost
# resolves to IPv6 while the agent binds IPv4.
MS_AGENT_URL=http://localhost:8020

# The token the provider forwards. Must match AUTH_BEARER_TOKEN above.
# NEXT_PUBLIC_AUTH_BEARER_TOKEN=super-secret-demo-token

# Read only by frontend/src/app/api/copilotkit-landing, the doc landing page's
# route.ts, as `process.env.AGENT_URL!`. No doc page says to set it, and that
# gap is the finding (FINDINGS.md #15), so it stays unset by default.
# AGENT_URL=http://localhost:8020/


# -- Threads, optional -------------------------------------------------------
# Server-side only, and read only by frontend/src/app/api/copilotkit-threads.
# Every other route runs fine without them. Leave them unset and that endpoint
# falls back to the in-memory runner: the read-only thread routes still answer,
# mutations return 422, and the prebuilt threads drawer stays locked.
#
# `copilotkit init` writes all four. This repo's values were copied from
# 1cli-testing/copilotkit-cli/npm-cli/.env; run `npx copilotkit@latest init` in
# a scratch directory to mint your own.

# Signed license token. Verified offline against a key bundled in
# @copilotkit/license-verifier -- no login and no network call. Its expiry is
# what eventually locks the drawer.
# COPILOTKIT_LICENSE_TOKEN=eyJhbGciOiJFZERTQSIs...

# Project key for the managed thread store. This is what persists threads.
# Renamed by the docs from INTELLIGENCE_API_KEY; both spellings are read.
# CPK_INTELLIGENCE_API_KEY=cpk-...

# Non-secret analytics identity, written by `copilotkit init` alongside the key.
# CPK_TELEMETRY_ID=...

# Managed Intelligence endpoints. REST and realtime are different hosts, so
# override both or neither.
# INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
# INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.copilotkit.ai
